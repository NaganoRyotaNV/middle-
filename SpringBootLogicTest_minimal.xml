<templateSet group="SpringBootLogicTestMinimal">
  <template name="ctrl-index" value="@GetMapping(&quot;&quot;)&#10;public String index() {&#10;    return &quot;$HTML$&quot;;&#10;}&#10;&#10;@PostMapping(&quot;/$POST_PATH$&quot;)&#10;public String post($PARAMS$) {&#10;    // POSTで受け取った値を処理する&#10;    return &quot;redirect:/$RETURN_PATH$&quot;; // 二重送信対策: POST後は最初の画面や一覧へredirectする&#10;}" description="Controller内: GET初期表示 + POST + redirect（二重送信対策）" toReformat="true" toShortenFQNames="true">
    <variable name="HTML" expression="&quot;index&quot;" defaultValue="&quot;index&quot;" alwaysStopAt="true" />
    <variable name="POST_PATH" expression="&quot;register&quot;" defaultValue="&quot;register&quot;" alwaysStopAt="true" />
    <variable name="PARAMS" expression="&quot;&quot;" defaultValue="&quot;&quot;" alwaysStopAt="true" />
    <variable name="RETURN_PATH" expression="&quot;ex01&quot;" defaultValue="&quot;ex01&quot;" alwaysStopAt="true" />
    <context><option name="JAVA_DECLARATION" value="true" /></context>
  </template>

  <template name="equals" value="if ($LEFT$ != null &amp;&amp; $LEFT$.equals($RIGHT$)) {&#10;    $END$&#10;}" description="String比較: ==ではなくequalsを使う" toReformat="true" toShortenFQNames="true">
    <variable name="LEFT" expression="&quot;str&quot;" defaultValue="&quot;str&quot;" alwaysStopAt="true" />
    <variable name="RIGHT" expression="&quot;\&quot;value\&quot;&quot;" defaultValue="&quot;\&quot;value\&quot;&quot;" alwaysStopAt="true" />
    <context><option name="JAVA_STATEMENT" value="true" /></context>
  </template>

  <template name="==" value="$LEFT$.equals($RIGHT$)" description="String比較候補: ==ではなくequals" toReformat="true" toShortenFQNames="true">
    <variable name="LEFT" expression="&quot;str&quot;" defaultValue="&quot;str&quot;" alwaysStopAt="true" />
    <variable name="RIGHT" expression="&quot;\&quot;value\&quot;&quot;" defaultValue="&quot;\&quot;value\&quot;&quot;" alwaysStopAt="true" />
    <context><option name="JAVA_EXPRESSION" value="true" /><option name="JAVA_STATEMENT" value="true" /></context>
  </template>

  <template name="session-declare" value="HttpSession session" description="Controllerメソッド引数: セッションスコープ宣言" toReformat="true" toShortenFQNames="true">
    <context><option name="JAVA_DECLARATION" value="true" /></context>
  </template>

  <template name="session-save" value="session.setAttribute(&quot;$KEY$&quot;, $VALUE$);" description="セッションスコープに保存" toReformat="true" toShortenFQNames="true">
    <variable name="KEY" expression="&quot;user&quot;" defaultValue="&quot;user&quot;" alwaysStopAt="true" />
    <variable name="VALUE" expression="&quot;user&quot;" defaultValue="&quot;user&quot;" alwaysStopAt="true" />
    <context><option name="JAVA_STATEMENT" value="true" /></context>
  </template>

  <template name="form-to-domain" value="$DOMAIN$ $DOMAIN_VAR$ = new $DOMAIN$();&#10;$DOMAIN_VAR$.setName(form.getName());&#10;$DOMAIN_VAR$.setAge(form.getAge());&#10;$DOMAIN_VAR$.setComment(form.getComment());&#10;$DOMAIN_VAR$.setGender(form.getGender());&#10;$DOMAIN_VAR$.setPrefecture(form.getPrefecture());&#10;if (form.getBirthday() != null &amp;&amp; !form.getBirthday().isEmpty()) {&#10;    $DOMAIN_VAR$.setBirthday(LocalDate.parse(form.getBirthday()));&#10;}" description="Formの値をDomainへコピー + LocalDate変換" toReformat="true" toShortenFQNames="true">
    <variable name="DOMAIN" expression="&quot;User&quot;" defaultValue="&quot;User&quot;" alwaysStopAt="true" />
    <variable name="DOMAIN_VAR" expression="&quot;user&quot;" defaultValue="&quot;user&quot;" alwaysStopAt="true" />
    <context><option name="JAVA_STATEMENT" value="true" /></context>
  </template>

  <template name="localdate-parse" value="if (form.getBirthday() != null &amp;&amp; !form.getBirthday().isEmpty()) {&#10;    domain.setBirthday(LocalDate.parse(form.getBirthday()));&#10;}" description="StringのbirthdayをLocalDate型へ変換" toReformat="true" toShortenFQNames="true">
    <context><option name="JAVA_STATEMENT" value="true" /></context>
  </template>
</templateSet>
